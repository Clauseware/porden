# Copy to .env in this directory. Replace every placeholder; do not commit real secrets.
PLATFORM_DOMAIN=api.porden.example
MERCHANT_DOMAIN=merchant.porden.example
COURIER_DOMAIN=courier.porden.example
ACME_EMAIL=operator@example.com
# Optional when a separately hosted dashboard needs browser access:
# DASHBOARD_PUBLIC_ORIGIN=https://dashboard.porden.example

# Use independent random hexadecimal passwords (for example: openssl rand -hex 32).
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
PLATFORM_DB_PASSWORD=REPLACE_WITH_RANDOM_PLATFORM_PASSWORD
MERCHANT_DB_PASSWORD=REPLACE_WITH_RANDOM_MERCHANT_PASSWORD
COURIER_DB_PASSWORD=REPLACE_WITH_RANDOM_COURIER_PASSWORD
PLATFORM_SESSION_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MERCHANT_SESSION_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
COURIER_SESSION_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
PARTNER_SECRET=REPLACE_WITH_SHARED_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MERCHANT_DEMO_PASSWORD=REPLACE_WITH_UNIQUE_MOCK_LOGIN_PASSWORD
COURIER_DEMO_PASSWORD=REPLACE_WITH_DIFFERENT_MOCK_LOGIN_PASSWORD

# Match the organizations and integration credentials in the private provisioning JSON.
MERCHANT_ORGANIZATION_ID=REPLACE_WITH_MERCHANT_UUID
COURIER_ORGANIZATION_ID=REPLACE_WITH_COURIER_UUID
MERCHANT_INTEGRATION_TOKEN=REPLACE_WITH_PROVISIONED_MERCHANT_TOKEN
COURIER_INTEGRATION_TOKEN=REPLACE_WITH_PROVISIONED_COURIER_TOKEN

# Three persistent P-256 PKCS8 keys default to ./secrets/{platform,merchant,courier}.pem.
# They must be readable by the API image's UID 1000. Keep private backups of them and .env.
# Never regenerate signing keys automatically on startup.
# Site-funded default inference for both merchant and courier agents (each site's /api/llm).
# Both values are required for agent features; the route serves only OPENROUTER_MODEL.
# Use a model ending in :free to keep inference at no cost.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Required Groq fallback, used only when OpenRouter is rate-limited, out of credits or unreachable.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
