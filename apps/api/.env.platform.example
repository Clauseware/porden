PORDEN_DATABASE_URL=postgres://porden_platform:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:54329/porden_platform
PORDEN_PUBLIC_ORIGIN=http://localhost:4300
PORDEN_ALLOWED_ORIGINS=http://localhost:4300,http://localhost:4100,http://localhost:4200
PORDEN_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PORDEN_SIGNING_KEY_PATH=tmp/platform-demo/platform.pem
PORDEN_SIGNING_KEY_ID=porden-platform-v1
PORDEN_PORT=5300
# Containers must listen on all interfaces; local development defaults to loopback.
# PORDEN_HOST=0.0.0.0
# Only required when using platform:provision to add records to an initialized database:
# PORDEN_PROVISION_FILE=/absolute/path/to/private-provisioning.json
# Optional after a key rotation: JSON file {"keys":[<retired public JWK>]} kept published so older receipts stay verifiable.
# PORDEN_SIGNING_RETIRED_KEYS_PATH=tmp/porden-keys/retired.json
