ORGANIZATION_ROLE=courier
PORT=5200
# HOST=0.0.0.0 # Set for containers; local development defaults to loopback.
PUBLIC_ORIGIN=http://localhost:4200
PEER_ORIGIN=http://localhost:4100
DATABASE_URL=postgres://porden_courier:local-courier-only@127.0.0.1:54329/porden_courier
SIGNING_KEY_PATH=tmp/porden-keys/courier.pem
SESSION_SECRET=replace-with-unique-32-character-courier-secret
PARTNER_SECRET=replace-with-shared-32-character-partner-secret
DEMO_PASSWORD=replace-with-courier-demo-password
# Required together to execute Porden-governed delivery transfers:
# PORDEN_API_ORIGIN=http://localhost:5300
# PORDEN_INTEGRATION_TOKEN=<courier-integration-token>
# PORDEN_ORGANIZATION_ID=<courier-platform-organization-uuid>
# PORDEN_PEER_ORGANIZATION_ID=<merchant-platform-organization-uuid>
