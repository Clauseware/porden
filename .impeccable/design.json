  "narrative": {
    "northStar": "The Quiet Relay",
    "overview": "Porden moves a task from one system to another and keeps a record of who approved what. The interface is a calm, near-black field where one colour, Oxide Lavender, marks every action that moves the task forward. Surfaces stay quiet so the handoff itself reads clearly: who holds the task, what was shared, what was approved, what is still unknown.",
    "keyCharacteristics": [
      "Dark-only (`color-scheme: dark`); no light theme.",
      "One accent hue, Oxide Lavender, on every action that matters and on focus.",
      "Flat tonal layering; no shadows.",
      "Inter / system sans for everything except IDs, digests and code.",
      "State always written in words; colour only supports it."
    ],
    "rules": [
      {
        "name": "The Lavender Means Go Rule",
        "body": "Lavender fills only elements that move a task forward or show where the keyboard is. Never use it for decoration, large backgrounds or illustration fills inside the app.",
        "section": "colors"
      },
      {
        "name": "The No Hard-Coded Hex Rule",
        "body": "Components use `var(--\u2026)` tokens from `apps/brand.css`. A new colour is added there first, with its contrast checked.",
        "section": "colors"
      },
      {
        "name": "The Words Not Weights Rule",
        "body": "Hierarchy comes from size and position. Do not add a second typeface or ultra-light weights.",
        "section": "typography"
      },
      {
        "name": "The Flat Relay Rule",
        "body": "Nothing floats. If an element needs more attention, it gets a lavender edge or fill, not a shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use tokens from `apps/brand.css` and the `PordenSymbol` component from `apps/logo.tsx`.",
      "**Do** give every action that moves a task forward the lavender primary style.",
      "**Do** write state in words (Accepted, Refused, Outcome unknown) next to any colour.",
      "**Do** show a visible lavender focus ring on every interactive element.",
      "**Do** keep motion to 120-180ms state transitions and honour `prefers-reduced-motion`."
    ],
    "donts": [
      "**Don't** add a light theme or light surfaces.",
      "**Don't** use shadows, gradients, glass or glow.",
      "**Don't** hard-code hex values in components or inline styles (the global error pages are the only exception, because they render without the stylesheet).",
      "**Don't** use lavender for decoration, illustration fills or large backgrounds inside the app.",
      "**Don't** imply success from optimistic UI state; show unknown outcomes as unknown."
    ]
  }
}
