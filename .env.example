# Server-side OpenRouter credentials. Never included in browser configuration.
OPENROUTER_API_KEY=
# Optional default model ID; otherwise enter a tool-calling model in AI settings.
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

HANDOFF_MERCHANT_PORT=4100
HANDOFF_COURIER_PORT=4200
# Optional absolute paths; omitted values use the project directory.
# HANDOFF_DB=
# HANDOFF_SIGNING_KEY=
