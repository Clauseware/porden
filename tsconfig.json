{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "noEmit": true, "skipLibCheck": true, "allowJs": true,
    "jsx": "preserve", "esModuleInterop": true, "types": ["bun"],
    "resolveJsonModule": true
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "vendor", "tmp", "**/.next", "apps/porden"]
}
