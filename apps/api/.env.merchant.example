ORGANIZATION_ROLE=merchant
PORT=5100
PUBLIC_ORIGIN=http://localhost:4100
PEER_ORIGIN=http://localhost:4200
DATABASE_URL=postgres://porden_merchant:local-merchant-only@127.0.0.1:54329/porden_merchant
SIGNING_KEY_PATH=tmp/porden-keys/merchant.pem
SESSION_SECRET=replace-with-unique-32-character-merchant-secret
PARTNER_SECRET=replace-with-shared-32-character-partner-secret
DEMO_PASSWORD=replace-with-merchant-demo-password
# Existing root .env may supply OPENROUTER_API_KEY and OPENROUTER_MODEL.
# Required together when creating Porden-governed delivery transfers:
# PORDEN_API_ORIGIN=http://localhost:5300
# PORDEN_INTEGRATION_TOKEN=<merchant-integration-token>
# PORDEN_ORGANIZATION_ID=<merchant-platform-organization-uuid>
# PORDEN_PEER_ORGANIZATION_ID=<courier-platform-organization-uuid>
